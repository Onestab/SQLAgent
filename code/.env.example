# LLM Provider: "ollama", "vllm", or "dashscope"
LLM_PROVIDER=ollama

# Ollama配置（本地模型，推荐）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# vLLM配置（本地GPU加速）
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=EMPTY

# 阿里百炼(DashScope)配置
DASHSCOPE_API_KEY=sk-...
DASHSCOPE_MODEL=qwen-plus

# Embedding模型配置
# EMBEDDING_PROVIDER: "sentence-transformers", "huggingface", "vllm", or "dashscope"
EMBEDDING_PROVIDER=sentence-transformers

# Sentence Transformers模型选项:
# - paraphrase-multilingual-MiniLM-L12-v2 (默认，多语言，轻量)
# - shibing624/text2vec-base-chinese (中文优化)
# - moka-ai/m3e-base (中文，效果好)
# - BAAI/bge-base-zh-v1.5 (中文，推荐)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# vLLM Embedding配置（本地GPU加速）
VLLM_EMBEDDING_BASE_URL=http://localhost:8000/v1
VLLM_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
VLLM_EMBEDDING_API_KEY=EMPTY

# 阿里百炼Embedding配置
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2

# 数据库配置
DB_TYPE=sqlite
DB_PATH=./database/ecommerce.db

# MySQL / PostgreSQL配置（当DB_TYPE不是sqlite时使用）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=user
DB_PASSWORD=secret

# 应用配置
DEBUG=false
MAX_RETRY_ATTEMPTS=3
